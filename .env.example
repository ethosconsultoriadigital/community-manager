DATABASE_URL=postgresql://postgres:devpass@localhost:5433/community_manager
REDIS_URL=redis://localhost:6379
# false en producción: solo el admin crea usuarios vía POST /admin/users
ALLOW_PUBLIC_REGISTER=true
JWT_SECRET=
JWT_EXPIRES_IN=7d
# 32 bytes en base64 — generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
META_APP_ID=
META_APP_SECRET=
# Debe coincidir exactamente con la URL configurada en la app de Meta
META_REDIRECT_URI=http://localhost:4000/oauth/meta/callback
# Threads (Fase 1). false hasta configurar app Threads en Meta Developer.
THREADS_PUBLISH_ENABLED=false
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:4000/oauth/threads/callback
# X / TikTok. Publicar TikTok exige flag + credenciales (video FILE_UPLOAD, privado en sandbox).
X_PUBLISH_ENABLED=false
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:4000/oauth/x/callback
TIKTOK_PUBLISH_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4000/oauth/tiktok/callback
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL pública del front (SEO: sitemap/robots). En Vercel: https://www.tudominio.com (sin / final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Recuperación de contraseña (Fase E). Sin RESEND_API_KEY el enlace se loguea en consola de la API.
RESEND_API_KEY=
EMAIL_FROM=Community Manager <onboarding@resend.dev>
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_REGION=auto
# URL pública para media local (Meta debe poder descargar el archivo)
MEDIA_PUBLIC_BASE_URL=http://localhost:4000
LLM_API_KEY=
# OpenAI Images (gpt-image-2 por defecto; dall-e-3 ya no existe en la API).
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
OPENAI_API_KEY=
# fal.ai — Reels (Hailuo 02) y lip-sync. En producción, sin FAL_KEY el Reel/avatar fallan con un mensaje claro (el mock solo vale en local).
FAL_KEY=
# Por defecto Hailuo 02 Standard. Si Render aún tiene video-01, el código lo redirige.
# FAL_VIDEO_MODEL=fal-ai/minimax/hailuo-02/standard/text-to-video
# FAL_IMAGE_TO_VIDEO_MODEL=fal-ai/minimax/hailuo-02/standard/image-to-video
# Opt-in más baratos (hay que poner LOS DOS; si no, el texto sigue en Hailuo):
#   Seedance 1.0 Pro Fast (9:16, duration "5", 720p):
#   FAL_VIDEO_MODEL=fal-ai/bytedance/seedance/v1/pro/fast/text-to-video
#   FAL_IMAGE_TO_VIDEO_MODEL=fal-ai/bytedance/seedance/v1/pro/fast/image-to-video
#   LTX 13B distilled (9:16, 121 frames @ 24fps, 720p):
#   FAL_VIDEO_MODEL=fal-ai/ltxv-13b-098-distilled
#   FAL_IMAGE_TO_VIDEO_MODEL=fal-ai/ltxv-13b-098-distilled/image-to-video
#   Alias cortos equivalentes: seedance | ltx
# 768P (Hailuo) o 512P. En Seedance/LTX, 512P baja a 480p y el default es 720p.
# FAL_VIDEO_RESOLUTION=768P
# true solo si quieres forzar el id viejo video-01.
# FAL_ALLOW_LEGACY_VIDEO_MODEL=false
# Reel multi-escena (Fase A/B): guion → keyframes → i2v → concat + subs + música. false = 1 clip.
# REEL_MULTI_SCENE=true
# REEL_SCENE_COUNT=2
# Tope de escenas (default 2). En Render 512MB no subir a 3–4 o habrá OOM/restart.
# REEL_MAX_SCENES=2
# Avatar: TTS ElevenLabs + lip-sync Sync-3. En producción faltan claves = error explícito, no mock.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Opt-in de voz en fal (hace falta FAL_KEY; ElevenLabs deja de usarse hasta quitar la variable):
# TTS_PROVIDER=elevenlabs
# TTS_PROVIDER=minimax
# TTS_VOICE_ID=Spanish_Narrator
#   otras: Spanish_SereneWoman, Spanish_ConfidentWoman, Spanish_WiseScholar
# TTS_PROVIDER=kokoro
# TTS_VOICE_ID=ef_dora
#   otras: em_alex, em_santa
# Avatar de labios. Vacío o sync = Sync-3. kling = fal-ai/kling-video/v1/standard/ai-avatar
# AVATAR_PROVIDER=sync
# AVATAR_PROVIDER=kling
# Lip-sync: Sync-3 (ilustraciones/cartoon). Un FAL_LIPSYNC_MODEL=fal-ai/sadtalker se ignora.
# FAL_LIPSYNC_MODEL=fal-ai/sync-lipsync/v3/image-to-video
# true solo para forzar SadTalker.
# FAL_ALLOW_LEGACY_LIPSYNC=false
# Espera máxima POR clip fal (ms). Default 1200000 = 20 min. Un Reel de 2 escenas puede sumar dos esperas;
# el worker y el polling del front aguantan ~50 min.
# FAL_QUEUE_MAX_WAIT_MS=1200000
# FAL_QUEUE_POLL_MS=3000
# Binario ffmpeg si el postinstall de ffmpeg-static no dejó el archivo.
# FFMPEG_PATH=




# Google Sheets (Radar). JSON completo de la service account en una sola línea.
# Misma variable para RadarMex y AAB. El token pide Sheets (lectura y escritura) y Drive de solo lectura.
# RadarMex puede seguir compartido como lector. La hoja AAB necesita Editor (escribe estado_redes y fecha_redes).
# La carpeta de portadas, Viewer, para bajar imagen_aab_url.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Sync periódico de fuentes sheet/news_radar (BullMQ). false para desactivar.
RADAR_SYNC_ENABLED=true
RADAR_SYNC_CRON=*/15 * * * *
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Debe coincidir con la URL configurada en la integración de Canva Connect
CANVA_REDIRECT_URI=http://localhost:4000/oauth/canva/callback
CANVA_RETURN_URL=http://localhost:4000/oauth/canva/return
# Opcional: plantilla por defecto si el cliente no define brand.canva.brandTemplateId
CANVA_DEFAULT_BRAND_TEMPLATE_ID=
# Opcional: token de desarrollo sin OAuth (solo pruebas locales)
CANVA_ACCESS_TOKEN=
# Horas antes de volver a sincronizar métricas de un post (Fase I)
METRICS_STALE_HOURS=6
# Parrilla PDF (HTML→Chromium). En Render usa @sparticuz/chromium.
# En local (Windows/Mac) opcional: ruta a Chrome si no se detecta sola.
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_PATH=
